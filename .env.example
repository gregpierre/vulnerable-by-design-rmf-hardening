# Copy this file to .env and fill in real values. .env is gitignored --
# never commit actual secrets (see VULN-09 / IA-5, SC-12).

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: if unset, init_db.py auto-generates a random admin password
# and prints it once (see VULN-10 / IA-5, CM-6). Set these to pin a
# known bootstrap username/password instead.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# Stage (a) ran with debug=True and host=0.0.0.0. Both now default safe
# (False / 127.0.0.1) unless explicitly overridden here (VULN-11, VULN-12).
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Set to True only once the app is served over TLS. Until then this must
# stay False or the session cookie will never be sent and login will
# appear broken (VULN-16 / SC-8, SC-23).
SESSION_COOKIE_SECURE=False

# Stage (e): override where the SQLite DB and audit log live, e.g. to
# point at a mounted volume inside a container (CONTAINER_SECURITY.md).
DATABASE_PATH=helpdesk.db
LOG_FILE_PATH=security.log
